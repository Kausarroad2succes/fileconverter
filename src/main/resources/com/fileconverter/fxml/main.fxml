<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fileconverter.controller.MainController">
    <left>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #2b2b2b;" prefWidth="180">
            <Button text="PDF Tools" maxWidth="Infinity" onAction="#showPdfTools" />
            <Button text="Image Tools" maxWidth="Infinity" onAction="#showImageTools" />
            <Button text="Audio Tools" maxWidth="Infinity" onAction="#showAudioTools" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;" />
    </center>
</BorderPane>
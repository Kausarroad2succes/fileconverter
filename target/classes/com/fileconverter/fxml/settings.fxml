<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1100.0" stylesheets="@/com/fileconverter/fxml/css/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fileconverter.controller.SettingsController">

    <left>
        <VBox prefWidth="220.0" spacing="4.0" styleClass="sidebar">
            <children>
                <Label styleClass="sidebar-title" text="File Converter">
                    <VBox.margin><Insets bottom="20.0" left="10.0" top="10.0" /></VBox.margin>
                </Label>
                <Button maxWidth="Infinity" onAction="#handleBackFromSettings" styleClass="sidebar-item" text="🏠  Home" />
                <VBox VBox.vgrow="ALWAYS" />
                <Button maxWidth="Infinity" styleClass="sidebar-item, sidebar-item-active" text="⚙️  Settings" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 24;">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="merger-banner">
                    <children>
                        <StackPane styleClass="merger-icon"><children><Label style="-fx-font-size: 26px;" text="⚙️" /></children></StackPane>
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="page-title" text="Settings" />
                                <Label styleClass="page-subtitle" text="Enter your premium activation code." />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="12.0" styleClass="panel-box">
                    <children>
                        <Label styleClass="step-title" text="Premium Activation Code" />
                        <PasswordField fx:id="codeField" promptText="Enter code" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button fx:id="unlockButton" onAction="#handleUnlock" styleClass="merge-button" text="Unlock →" />
                                <ProgressIndicator fx:id="loadingIndicator" prefHeight="24.0" prefWidth="24.0" visible="false" managed="false" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label fx:id="statusLabel" styleClass="status-label" />

                <VBox fx:id="premiumPanel" alignment="CENTER" prefHeight="120.0" spacing="12.0" styleClass="panel-box" visible="false" managed="false">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #22c55e;" text="✨ Premium Unlocked!" />
                        <CheckBox fx:id="nightModeToggle" onAction="#handleToggleNightMode" text="🌙 Enable Night Mode" />
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>
</BorderPane>